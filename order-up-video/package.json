{
  "name": "order-up-launch-video",
  "private": true,
  "type": "module",
  "description": "15s motion graphics launch video for Goated's new original game, Order Up.",
  "scripts": {
    "audio": "python3 audio/build_soundtrack.py",
    "render": "node render.mjs",
    "render:preview": "node render.mjs --fps 30 --blur 0 --out out/preview-30fps.mp4",
    "stills": "node tools/stills.mjs",
    "preview": "npx http-server . -p 8080 -c-1"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "playwright": "1.56.1",
    "sharp": "^0.34.5"
  }
}
